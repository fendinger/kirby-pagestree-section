{
    "name": "fendinger/kirby-pagestree-section",
    "description": "Kirby 5 and 6 Panel plugin that displays pages as a collapsible tree view",
    "type": "kirby-plugin",
    "version": "1.1.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Jens Fendinger",
            "email": "jens@fendinger.de",
            "homepage": "https://fendinger.de"
        }
    ],
    "homepage": "https://github.com/fendinger/kirby-pagestree-section",
    "keywords": [
        "kirby",
        "kirby-plugin",
        "panel",
        "section",
        "tree",
        "pages"
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "getkirby/composer-installer": "^1.2"
    },
    "extra": {
        "kirby": {
            "compatible": "^5.0 || ^6.0"
        }
    },
    "config": {
        "allow-plugins": {
            "getkirby/composer-installer": true
        }
    }
}
